{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./app/src/*"]
    }
  },
  "include": [
    "app/src/**/*.ts",
    "app/src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.sites.config.ts",
    "worker/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
